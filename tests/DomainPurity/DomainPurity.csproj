<Project Sdk="Microsoft.NET.Sdk">

  <!--
    领域层的「脱离 Godot 也能编译**并运行**」证明 —— 不变量 **I9**。

    **它为什么存在**：`tests/Claude-Code-Game-Studios.Tests.csproj` 通过
    `ProjectReference` 引用整个主工程，而主工程是 `Godot.NET.Sdk` 且引用 `GodotSharp`
    ⇒ **在这个测试工程里跑的测试，无法证明「领域层脱离 Godot 也能编译运行」**
    —— GodotSharp 已经在引用链上，`using Godot` 也一定能编译成功。
    换句话说：`DomainLayerPurityTests` 守的是「领域层**没有引用** Godot」，
    而本工程守的是「领域层**在没有 Godot 的情况下真的能编译、真的能跑**」。

    ⚠️⚠️ **它必须零依赖 —— 而且这一点是踩出来的**：
    本工程**曾经**用 `gdUnit4.api` + `gdUnit4.test.adapter` 当测试运行器，
    看起来「gdUnit4 不需要 GodotSharp」（只引它确实能编译能跑）。
    **但 gdUnit4.api 传递依赖 `GodotSharp`** ⇒ 依赖图里仍然有 GodotSharp
    ⇒ 领域层里写一行 `using Godot;` **照样编译通过** ⇒ **那道门形同虚设**。
    一个「看起来在守、其实不守」的守卫**比没有守卫更糟**（它让人以为有人盯着）。
    ⇒ 现在它是一个**零依赖的控制台程序**：`OutputType=Exe`、**不引任何包**。
    `Program.Main` 做三件事：
      ① 跑几条领域规则（编译 + 运行都得到证明）；
      ② 检查**本程序集引用了哪些程序集** ⇒ 必须没有 Godot（运行时证明，比静态扫描强：
         静态扫描查源码字样，这一条查**产物** ⇒ 反射、延迟加载也躲不过）；
      ③ 任一条不成立 ⇒ 退出码非 0 ⇒ CI 红。

    **它故意什么都不引**：
      ✗ 不用 `Godot.NET.Sdk`（那会把 Godot 的引用链带进来）
      ✗ 不引用 `GodotSharp`
      ✗ **不引任何 NuGet 包**（包括测试运行器 —— 见上面的踩坑）
      ✗ 不 `ProjectReference` 主工程（那会把整个游戏拖进来）
    它只**直接编译** `src/Domain/**` 的源文件 —— 领域层是自包含的
    （只引用自己的 `ClaudeCodeGameStudios.Domain.*` 命名空间），所以这样编译得起来。
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <!-- ⚠️ **零依赖是硬要求**：引任何包都要先确认它不会把 GodotSharp 拖进来。 -->
    <RestorePackages>false</RestorePackages>
    <!-- Godot 的动态加载在这里**必须关掉**（它只对 Godot.NET.Sdk 有意义，
         留着是为了万一有人把它换成那个 SDK 时会看到这一行）。 -->
    <EnableDynamicLoading>false</EnableDynamicLoading>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- 本工程有自己的入口点（Program.Main）⇒ 不要再生成一个。 -->
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- 领域层源文件（30 个）。**不引用主工程** ⇒ 没有 GodotSharp。 -->
    <Compile Include="../../src/Domain/**/*.cs" />
    <!-- 本工程自己的 `Program.cs` 由 SDK 的默认 glob 包含（再显式写一遍会重复）。 -->
  </ItemGroup>

</Project>
